---
import Input from '../shared/ui/Input.astro';
import Textarea from '../shared/ui/Textarea.astro';

const siteKey = Astro.locals.runtime.env.TURNSTILE_SITE_KEY || '';
---

<form id="contact-form" class="space-y-6" novalidate>
	<div class="grid sm:grid-cols-2 gap-6">
		<Input
			type="text"
			id="name"
			name="name"
			label="Full Name"
			placeholder="Your name"
			required
		/>
		<Input
			type="email"
			id="email"
			name="email"
			label="Email"
			placeholder="your@email.com"
			required
		/>
	</div>

	<Input
		type="tel"
		id="phone"
		name="phone"
		label="Phone Number"
		placeholder="Your phone number (optional)"
	/>

	<Input
		type="text"
		id="location"
		name="location"
		label="Location"
		placeholder="City, Country"
		required
	/>

	<Input
		type="text"
		id="subject"
		name="subject"
		label="Subject"
		placeholder="How can I help you?"
		required
	/>

	<Textarea
		id="message"
		name="message"
		label="Message"
		placeholder="Tell me a bit about what you're going through..."
		rows={5}
		required
	/>

	{siteKey && (
		<div
			class="cf-turnstile"
			data-sitekey={siteKey}
			data-theme="dark"
			data-size="flexible"
		></div>
	)}

	<div class="space-y-3">
		<button
			id="contact-submit"
			type="submit"
			class="inline-flex items-center justify-center font-medium transition-all duration-300 rounded-md bg-primary text-white hover:bg-primary-light shadow-md hover:shadow-lg hover:shadow-primary/30 px-8 py-4 text-lg"
		>
			Send Enquiry
		</button>
		<p class="text-sm text-charcoal-light">
			New sessions are currently paused. This form sends an enquiry only and does not
			confirm a counselling appointment.
		</p>
	</div>

	<!-- Status message -->
	<div id="form-status" class="hidden rounded-lg p-4 text-sm" role="alert"></div>
</form>

<script>
	function initContactForm() {
		const form = document.getElementById('contact-form') as HTMLFormElement | null;
		const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
		const statusEl = document.getElementById('form-status') as HTMLDivElement | null;

		if (!form || !submitBtn || !statusEl) return;

		form.addEventListener('submit', async (e) => {
			e.preventDefault();

			// Reset status
			statusEl.classList.add('hidden');
			statusEl.textContent = '';

			// Collect form data
			const formData = new FormData(form);
			const data: Record<string, string> = {};
			formData.forEach((value, key) => {
				data[key] = value.toString();
			});

			// Include Turnstile token if present
			const turnstileInput = form.querySelector<HTMLInputElement>(
				'input[name="cf-turnstile-response"]',
			);
			if (turnstileInput?.value) {
				data['cf-turnstile-response'] = turnstileInput.value;
			}

			// Set loading state
			const originalText = submitBtn.textContent;
			submitBtn.textContent = 'Sending...';
			submitBtn.disabled = true;
			submitBtn.classList.add('opacity-70', 'cursor-not-allowed');

			try {
				const response = await fetch('/api/contact', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});

				const result = await response.json();

				if (result.success) {
					showStatus(
						statusEl,
						'Your enquiry has been sent. Please note that new sessions are currently paused, so this does not confirm an appointment.',
						'success',
					);
					form.reset();
					// Reset Turnstile widget if available
					if (typeof (window as any).turnstile !== 'undefined') {
						(window as any).turnstile.reset();
					}
				} else {
					showStatus(
						statusEl,
						result.error || 'Something went wrong. Please try again.',
						'error',
					);
				}
			} catch {
				showStatus(
					statusEl,
					'Unable to send your message. Please check your connection and try again.',
					'error',
				);
			} finally {
				submitBtn.textContent = originalText;
				submitBtn.disabled = false;
				submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
			}
		});
	}

	function showStatus(el: HTMLElement, message: string, type: 'success' | 'error') {
		el.textContent = message;
		el.classList.remove(
			'hidden',
			'bg-green-900/30',
			'border-green-500/50',
			'text-green-200',
			'bg-red-900/30',
			'border-red-500/50',
			'text-red-200',
		);

		if (type === 'success') {
			el.classList.add('bg-green-900/30', 'border', 'border-green-500/50', 'text-green-200');
		} else {
			el.classList.add('bg-red-900/30', 'border', 'border-red-500/50', 'text-red-200');
		}
	}

	// Support Astro view transitions
	document.addEventListener('astro:page-load', initContactForm);
</script>
